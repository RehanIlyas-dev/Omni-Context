# Groq API key for LLM generation
# Get one at https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here

# Redis URL for the semantic cache
# Local: redis://localhost:6379
# Render (Key Value addon): redis://:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# Frontend API base URL (only needed when serving frontend separately from backend)
# Local dev with Vite proxy: leave commented out or set to /api
# Vercel/Render: set to your backend URL
# VITE_API_URL=http://localhost:8000/api
